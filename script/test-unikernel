#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "${SCRIPT_DIR}")"

# Ensure ops is on PATH
export PATH="${HOME}/.ops/bin:${PATH}"

BINARY="${PROJECT_DIR}/dist/server"
PORT="${PORT:-8080}"
BASE_URL="http://localhost:${PORT}"
MAX_RETRIES=15
RETRY_DELAY=2
OPS_PID=""
PASSED=0
FAILED=0

# --- Helpers ---

cleanup() {
    if [[ -n "${OPS_PID}" ]]; then
        echo ""
        echo "Shutting down unikernel (pid ${OPS_PID})..."
        kill -TERM "${OPS_PID}" 2>/dev/null || true
        # Give it a moment, then force kill the process group
        sleep 1
        kill -9 "${OPS_PID}" 2>/dev/null || true
    fi
}
trap cleanup EXIT

wait_for_ready() {
    echo "Waiting for unikernel to boot..."
    for i in $(seq 1 "${MAX_RETRIES}"); do
        if curl -sf "${BASE_URL}/healthz" > /dev/null 2>&1; then
            echo "Unikernel ready after ~$(( (i - 1) * RETRY_DELAY ))s"
            return 0
        fi
        sleep "${RETRY_DELAY}"
    done
    echo "FATAL: Unikernel did not become ready after $(( MAX_RETRIES * RETRY_DELAY ))s"
    return 1
}

assert_status() {
    local test_name="$1"
    local expected_code="$2"
    local actual_code="$3"
    if [[ "${actual_code}" -eq "${expected_code}" ]]; then
        return 0
    fi
    echo "  FAIL: expected HTTP ${expected_code}, got ${actual_code}"
    return 1
}

assert_contains() {
    local test_name="$1"
    local expected="$2"
    local body="$3"
    if echo "${body}" | grep -q "${expected}"; then
        return 0
    fi
    echo "  FAIL: response body missing '${expected}'"
    echo "  Body: ${body}"
    return 1
}

pass() {
    echo "  PASS: $1"
    PASSED=$((PASSED + 1))
}

fail() {
    echo "  FAIL: $1"
    FAILED=$((FAILED + 1))
}

# --- Preflight ---

if [[ ! -f "${BINARY}" ]]; then
    echo "Binary not found at ${BINARY}. Run script/build first."
    exit 1
fi

ARCH_FLAG=""
if [[ "$(uname -m)" != "x86_64" ]]; then
    ARCH_FLAG="--arch=amd64"
fi

# --- Boot unikernel ---

echo "Booting unikernel on port ${PORT}..."
# shellcheck disable=SC2086
ops run ${ARCH_FLAG} -p "${PORT}" -c "${PROJECT_DIR}/config.json" "${BINARY}" &
OPS_PID=$!

wait_for_ready

echo ""
echo "=== Unikernel Integration Tests ==="
echo ""

# --- Test: GET /healthz ---

echo "[1/3] GET /healthz"
HTTP_CODE=$(curl -sf -o /tmp/uk-test-body -w '%{http_code}' "${BASE_URL}/healthz" 2>/dev/null) || HTTP_CODE="000"
BODY=$(cat /tmp/uk-test-body 2>/dev/null || echo "")

if assert_status "/healthz" 200 "${HTTP_CODE}" && assert_contains "/healthz" '"status":"ok"' "${BODY}"; then
    pass "GET /healthz -> 200 with status ok"
else
    fail "GET /healthz"
fi

# --- Test: GET /version ---

echo "[2/3] GET /version"
HTTP_CODE=$(curl -sf -o /tmp/uk-test-body -w '%{http_code}' "${BASE_URL}/version" 2>/dev/null) || HTTP_CODE="000"
BODY=$(cat /tmp/uk-test-body 2>/dev/null || echo "")

if assert_status "/version" 200 "${HTTP_CODE}" && assert_contains "/version" '"version"' "${BODY}"; then
    pass "GET /version -> 200 with version field"
else
    fail "GET /version"
fi

# --- Test: POST /echo ---

echo "[3/3] POST /echo"
HTTP_CODE=$(curl -sf -o /tmp/uk-test-body -w '%{http_code}' \
    -X POST "${BASE_URL}/echo" \
    -H 'Content-Type: application/json' \
    -d '{"hello":"world","count":42}' 2>/dev/null) || HTTP_CODE="000"
BODY=$(cat /tmp/uk-test-body 2>/dev/null || echo "")

if assert_status "/echo" 200 "${HTTP_CODE}" \
    && assert_contains "/echo" '"hello":"world"' "${BODY}" \
    && assert_contains "/echo" '"count":42' "${BODY}"; then
    pass "POST /echo -> 200 with echoed body"
else
    fail "POST /echo"
fi

# --- Results ---

echo ""
echo "=== Results: ${PASSED} passed, ${FAILED} failed ==="

rm -f /tmp/uk-test-body

if [[ "${FAILED}" -gt 0 ]]; then
    exit 1
fi
